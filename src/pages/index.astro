---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

function formatDate(date: Date) {
  return date.toLocaleDateString("en-GB", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
}
---

<Base title="thinking machines" activeNav="writing">
  <div class="text-[0.625rem] font-medium uppercase tracking-[0.2em] text-text-dim mb-12 pb-2 border-b border-border">
    Recent <span class="text-accent-dim">— {new Date().getFullYear()}</span>
  </div>

  <div class="flex flex-col">
    {posts.map((post) => (
      <a href={`/blog/${post.id}`} class="group block no-underline">
        <article class:list={[
          "py-10 border-b border-border transition-colors duration-300 cursor-pointer",
          { "bg-bg-elevated p-10 -mx-8 px-8 border border-border mb-8": post.data.featured },
        ]}>
          <div class="flex items-center gap-4 mb-2 text-[0.6875rem] text-text-dim font-light">
            <span class="text-accent-dim uppercase tracking-[0.08em] text-[0.625rem] font-medium">{post.data.tag}</span>
            <span class="text-border-hover">/</span>
            <span>{formatDate(post.data.pubDate)}</span>
          </div>
          <h2 class:list={[
            "font-serif font-normal leading-[1.3] text-text-primary mb-2 tracking-[-0.02em] transition-colors duration-200 group-hover:text-accent",
            post.data.featured ? "text-[1.75rem]" : "text-[1.5rem]",
          ]}>
            {post.data.title}
          </h2>
          <p class="text-text-muted text-[0.8125rem] leading-[1.7] font-light max-w-[580px]">
            {post.data.description}
          </p>
        </article>
      </a>
    ))}
  </div>
</Base>
