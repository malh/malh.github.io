---
import Base from "../layouts/Base.astro";
---

<Base title="Mal Hamdan">
  <section class="hero">
    <h1>Hey, I'm Mal.</h1>
    <p>Welcome to my corner of the internet.</p>
  </section>
</Base>

<style>
  .hero {
    padding: 4rem 0;
  }

  .hero h1 {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .hero p {
    font-size: 1.2rem;
    color: var(--color-text-muted);
  }
</style>
