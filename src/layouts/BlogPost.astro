---
import Base from "./Base.astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tag: string;
}

const { title, description, pubDate, tag } = Astro.props;

const readingTime = "5 min read";
const formattedDate = pubDate.toLocaleDateString("en-GB", {
  day: "2-digit",
  month: "short",
  year: "numeric",
});
---

<Base title={`${title} — thinking machines`} description={description} activeNav="writing">
  <a href="/" class="inline-flex items-center gap-2 text-[0.6875rem] text-text-dim no-underline mb-10 hover:text-text-muted transition-colors duration-200">
    &larr; back
  </a>

  <div class="flex items-center gap-4 mb-8 text-[0.6875rem] text-text-dim font-light">
    <span class="text-accent-dim uppercase tracking-[0.08em] text-[0.625rem] font-medium">{tag}</span>
    <span class="text-border-hover">/</span>
    <span>{formattedDate}</span>
    <span class="text-border-hover">/</span>
    <span>{readingTime}</span>
  </div>

  <h1 class="font-serif text-[2.25rem] font-normal leading-[1.2] text-text-primary mb-20 tracking-[-0.03em] max-w-[640px]">
    {title}
  </h1>

  <div class="prose">
    <slot />
  </div>
</Base>
